# Where this site deploys to.
#
# Copy to tools/deploy.env and fill in. That file is gitignored: this
# repository is public, and a server address plus an account name is most of
# what someone needs to start guessing at a password.
#
#   cp tools/deploy.env.sample tools/deploy.env
#
# All four are shown in hPanel under Advanced -> SSH Access.

DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=65002
DEPLOY_USER=uXXXXXXXXX
DEPLOY_REMOTE_ROOT=domains/example.com/public_html
