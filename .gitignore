# ── Automation layer ────────────────────────────────────────
# Live credentials. config.sample.php is the one that is committed.
/automation/private/config.php
# Written at runtime on the server.
/automation/private/logs/
/automation/private/posts/
# Local development only: the combined web root, captured mail, sessions.
/automation/.dev/
# Build output (regenerate: bash automation/tools/package.sh)
/automation/dist/

# Deploy target (host, account, path). Copy tools/deploy.env.sample.
/tools/deploy.env
