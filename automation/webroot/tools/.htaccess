# One controller for the public tools.
#   /tools/free-website-audit/        -> index.php
#   /tools/free-website-audit/report/ -> index.php
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tools/
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^free-website-audit(/report)?/?$ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "^(?!index\.php$).*\.php$">
  Require all denied
</FilesMatch>
