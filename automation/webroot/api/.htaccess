# The API is PHP only. Nothing else in this folder should ever be fetched.
<FilesMatch "\.(php)$">
  Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.php$).*$">
  Require all denied
</FilesMatch>

# These endpoints are for browsers and crawlers, never for search indexes.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# No directory listing, no automatic index.
Options -Indexes
